---
import ArticleLayout from '../../layouts/ArticleLayout.astro';

const grades = [
  {
    grade: 'Α΄ Λυκείου',
    icon: '⚡',
    color: '#534AB7',
    chapters: [
      {
        title: 'Κινηματική',
        topics: ['Ευθύγραμμη ομαλή & ομαλά μεταβαλλόμενη', 'Ελεύθερη πτώση', 'Βολή', 'Κυκλική κίνηση'],
        sheets: 7, diff: 2,
      },
      {
        title: 'Δυναμική',
        topics: ['Νόμοι Newton', 'Τριβή', 'Κεντρομόλος δύναμη', 'Ζεύγη δυνάμεων'],
        sheets: 8, diff: 3,
      },
      {
        title: 'Ενέργεια & Ισχύς',
        topics: ['Έργο δύναμης', 'Κινητική & δυναμική ενέργεια', 'ΑΔΙΕ', 'Ισχύς'],
        sheets: 6, diff: 2,
      },
    ],
  },
  {
    grade: 'Β΄ Λυκείου',
    icon: '🌊',
    color: '#1D9E75',
    chapters: [
      {
        title: 'Θερμοδυναμική',
        topics: ['Θερμοκρασία & Θερμότητα', 'Νόμοι αερίων', 'Θερμικές μηχανές', '1ος & 2ος Νόμος'],
        sheets: 7, diff: 3,
      },
      {
        title: 'Ταλαντώσεις & Κύματα',
        topics: ['Αρμονική ταλάντωση', 'Εκκρεμές', 'Κυματική', 'Συχνότητα & Μήκος κύματος'],
        sheets: 6, diff: 2,
      },
    ],
  },
  {
    grade: 'Γ΄ Λυκείου',
    icon: '⚛️',
    color: '#534AB7',
    chapters: [
      {
        title: 'Ηλεκτρισμός & Μαγνητισμός',
        topics: ['Ηλεκτρικό πεδίο', 'Μαγνητικό πεδίο', 'Επαγωγή Faraday', 'Εναλλασσόμενο ρεύμα'],
        sheets: 9, diff: 3,
      },
      {
        title: 'Κβαντική & Πυρηνική',
        topics: ['Φωτοηλεκτρικό φαινόμενο', 'De Broglie', 'Πυρηνικές αντιδράσεις', 'Ραδιενέργεια'],
        sheets: 7, diff: 3,
      },
      {
        title: 'Ειδική Θεωρία Σχετικότητας',
        topics: ['Αρχές Einstein', 'Χρονική διαστολή', 'Ισοδυναμία μάζας-ενέργειας'],
        sheets: 4, diff: 3,
      },
    ],
  },
];

function stars(n: number) {
  return '★'.repeat(n) + '☆'.repeat(3 - n);
}

const panellinies = [
  { icon: '📐', title: 'Θέματα Πανελληνίων', desc: 'Αρχείο θεμάτων 2010-2024 κατά κεφάλαιο' },
  { icon: '✍️', title: 'Λυμένα θέματα', desc: 'Αναλυτικές λύσεις με σχολιασμό βημάτων' },
  { icon: '📊', title: 'Στατιστική Πανελληνίων', desc: 'Ποια κεφάλαια εξετάζονται πιο συχνά' },
];
---

<ArticleLayout
  title="Φυσική Λυκείου"
  eyebrow="Δευτεροβάθμια Εκπαίδευση"
  description="Αναλυτικά φύλλα εργασίας, λυμένα θέματα Πανελληνίων και προσομοιώσεις για όλα τα κεφάλαια φυσικής Α΄, Β΄ και Γ΄ Λυκείου."
  heroIcon="⚛️"
  heroBg="linear-gradient(135deg, #26215C, #534AB7)"
>

  <div class="breadcrumb">
    <a href="/">InclusiLab</a> › <a href="/physics">Φυσική</a> › Λύκειο
  </div>

  <!-- Panellinies strip -->
  <div class="panel-strip">
    <div class="panel-label">🎯 Πανελλήνιες</div>
    <div class="panel-cards">
      {panellinies.map(p => (
        <a href="#" class="panel-card">
          <span class="panel-icon">{p.icon}</span>
          <div>
            <strong>{p.title}</strong>
            <span>{p.desc}</span>
          </div>
        </a>
      ))}
    </div>
  </div>

  {grades.map(g => (
    <section class="grade-section">
      <div class="grade-header" style={`border-left-color:${g.color};`}>
        <span class="grade-icon">{g.icon}</span>
        <h2 style={`color:${g.color};`}>{g.grade}</h2>
      </div>
      <div class="chapters-grid">
        {g.chapters.map(ch => (
          <div class="chapter-card" style={`--accent:${g.color};`}>
            <div class="chapter-top">
              <h3>{ch.title}</h3>
              <span class="diff-stars" title={`Επίπεδο ${ch.diff}/3`}>{stars(ch.diff)}</span>
            </div>
            <ul class="topics-list">
              {ch.topics.map(t => <li>{t}</li>)}
            </ul>
            <div class="chapter-footer">
              <span class="sheet-count">📄 {ch.sheets} φύλλα</span>
              <div class="chapter-actions">
                <a href="#" class="btn btn-outline chapter-btn">Προβολή</a>
                <a href="#" class="btn btn-primary chapter-btn">Λήψη</a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>
  ))}

  <div class="legend-row">
    <strong>Επίπεδο δυσκολίας:</strong>
    <span class="legend-item"><span class="stars">★☆☆</span> Εύκολο</span>
    <span class="legend-item"><span class="stars">★★☆</span> Μεσαίο</span>
    <span class="legend-item"><span class="stars">★★★</span> Δύσκολο (Πανελλήνιες)</span>
  </div>

</ArticleLayout>

<style>
  .breadcrumb { font-size: 13px; color: var(--fg3); margin-bottom: 36px; }
  .breadcrumb a { color: var(--purple); text-decoration: none; }

  .panel-strip {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 20px 24px; margin-bottom: 48px;
  }
  .panel-label { font-size: 11px; font-weight: 700; color: var(--purple); letter-spacing: .1em; text-transform: uppercase; margin-bottom: 14px; }
  .panel-cards { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; }
  .panel-card {
    display: flex; align-items: flex-start; gap: 10px;
    text-decoration: none; padding: 12px 14px;
    background: var(--bg); border: 1px solid var(--border);
    border-radius: var(--radius-sm); transition: border-color .15s;
  }
  .panel-card:hover { border-color: var(--purple); text-decoration: none; }
  .panel-icon { font-size: 20px; flex-shrink: 0; }
  .panel-card strong { display: block; font-size: 13px; color: var(--fg); font-weight: 600; margin-bottom: 2px; }
  .panel-card span { font-size: 11px; color: var(--fg3); line-height: 1.4; }

  .grade-section { margin-bottom: 52px; }
  .grade-header { display: flex; align-items: center; gap: 14px; border-left: 4px solid; padding-left: 16px; margin-bottom: 20px; }
  .grade-icon { font-size: 28px; }
  .grade-header h2 { font-family: var(--font-heading); font-size: 20px; font-weight: 700; }

  .chapters-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; }
  .chapter-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-top: 3px solid var(--accent);
    border-radius: var(--radius-sm); padding: 20px;
    display: flex; flex-direction: column; gap: 14px;
    transition: transform .2s, box-shadow .2s;
  }
  .chapter-card:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.07); }
  .chapter-top { display: flex; justify-content: space-between; align-items: flex-start; gap: 8px; }
  .chapter-top h3 { font-family: var(--font-heading); font-size: 14px; font-weight: 700; line-height: 1.3; }
  .diff-stars { font-size: 12px; color: #f59e0b; white-space: nowrap; letter-spacing: 1px; flex-shrink: 0; }
  .topics-list { list-style: none; display: flex; flex-direction: column; gap: 5px; flex: 1; }
  .topics-list li { font-size: 12px; color: var(--fg2); padding-left: 14px; position: relative; line-height: 1.4; }
  .topics-list li::before { content: '→'; position: absolute; left: 0; color: var(--accent); font-size: 10px; top: 2px; }
  .chapter-footer { display: flex; justify-content: space-between; align-items: center; padding-top: 10px; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 8px; }
  .sheet-count { font-size: 11px; color: var(--fg3); }
  .chapter-actions { display: flex; gap: 6px; }
  .chapter-btn { font-size: 11px; padding: 6px 12px; }

  .legend-row {
    display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
    padding: 14px 20px; background: var(--bg2);
    border: 1px solid var(--border); border-radius: var(--radius-sm);
    font-size: 13px; color: var(--fg3);
  }
  .legend-item { display: flex; align-items: center; gap: 6px; }
  .stars { color: #f59e0b; letter-spacing: 1px; }

  @media (max-width: 1024px) { .chapters-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 768px) {
    .chapters-grid { grid-template-columns: 1fr; }
    .panel-cards { grid-template-columns: 1fr; }
  }
</style>
