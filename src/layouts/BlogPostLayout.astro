---
import PageLayout from './PageLayout.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  category: string;
  tags: string[];
  readTime: string;
  emoji?: string;
  bg?: string;
}

const { title, description, date, category, tags, readTime, emoji = '📝', bg = '#EEEDFE' } = Astro.props;
---

<PageLayout {title} {description}>
  <article class="blog-post">

    <div class="post-hero" style={`background:${bg};`}>
      <div class="container">
        <div class="post-meta-top">
          <a href="/blog" class="back-link">← Πίσω στο Blog</a>
          <span class="post-cat">{category}</span>
        </div>
        <div class="post-emoji">{emoji}</div>
        <h1>{title}</h1>
        <p class="post-desc">{description}</p>
        <div class="post-meta-bottom">
          <span>📅 {date}</span>
          <span>·</span>
          <span>⏱ {readTime}</span>
        </div>
        <div class="post-tags">
          {tags.map(t => <span class="tag">{t}</span>)}
        </div>
      </div>
    </div>

    <div class="container post-layout">
      <div class="post-content prose">
        <slot />
      </div>
      <aside class="post-sidebar">
        <div class="sidebar-card">
          <h4>Σε αυτό το άρθρο</h4>
          <div id="toc" class="toc"></div>
        </div>
        <div class="sidebar-card">
          <h4>Σχετικές σελίδες</h4>
          <ul class="rel-links">
            <li><a href="/eae">ΕΑΕ & Φυσική →</a></li>
            <li><a href="/simulations">Προσομοιώσεις →</a></li>
            <li><a href="/ai">AI Εργαλεία →</a></li>
            <li><a href="/legislation">Νομοθεσία →</a></li>
          </ul>
        </div>
      </aside>
    </div>

  </article>
</PageLayout>

<style>
  .post-hero {
    padding: 48px 0 40px;
    border-bottom: 1px solid var(--border);
  }
  .post-meta-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
  .back-link { font-size: 13px; color: var(--fg3); text-decoration: none; font-weight: 500; }
  .back-link:hover { color: var(--purple); text-decoration: none; }
  .post-cat { font-size: 11px; font-weight: 700; color: var(--purple); letter-spacing: .08em; text-transform: uppercase; }
  .post-emoji { font-size: 52px; margin-bottom: 20px; }
  .post-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(1.6rem, 4vw, 2.4rem);
    font-weight: 700; letter-spacing: -0.5px;
    color: var(--fg); margin-bottom: 16px; max-width: 700px;
    text-wrap: balance;
  }
  .post-desc { font-size: 17px; color: var(--fg2); line-height: 1.65; max-width: 620px; margin-bottom: 20px; }
  .post-meta-bottom { display: flex; gap: 8px; align-items: center; font-size: 13px; color: var(--fg3); margin-bottom: 14px; }
  .post-tags { display: flex; flex-wrap: wrap; gap: 6px; }

  .post-layout {
    display: grid;
    grid-template-columns: 1fr 260px;
    gap: 56px;
    padding-top: 48px;
    padding-bottom: 72px;
    align-items: flex-start;
  }

  .post-sidebar { position: sticky; top: 90px; }
  .sidebar-card {
    background: var(--bg2); border: 1px solid var(--border);
    border-radius: var(--radius-sm); padding: 20px;
    margin-bottom: 16px;
  }
  .sidebar-card h4 { font-family: var(--font-heading); font-size: 13px; font-weight: 700; margin-bottom: 12px; color: var(--fg3); letter-spacing: .06em; text-transform: uppercase; }
  .toc { font-size: 13px; }
  .rel-links { list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .rel-links li a { font-size: 13px; color: var(--purple); text-decoration: none; }
  .rel-links li a:hover { text-decoration: underline; }

  @media (max-width: 900px) {
    .post-layout { grid-template-columns: 1fr; }
    .post-sidebar { position: static; }
  }
</style>

<script>
// Auto-build table of contents from h2/h3 headings in content
const headings = document.querySelectorAll('.prose h2, .prose h3');
const toc = document.getElementById('toc');
if (toc && headings.length > 0) {
  const ul = document.createElement('ul');
  ul.style.cssText = 'list-style:none;display:flex;flex-direction:column;gap:6px;';
  headings.forEach((h, i) => {
    if (!h.id) h.id = `heading-${i}`;
    const li = document.createElement('li');
    const a = document.createElement('a');
    a.href = `#${h.id}`;
    a.textContent = h.textContent || '';
    a.style.cssText = `font-size:12px;color:var(--fg2);text-decoration:none;padding-left:${h.tagName==='H3'?'12px':'0'};display:block;line-height:1.4;`;
    a.addEventListener('mouseover', () => a.style.color = 'var(--purple)');
    a.addEventListener('mouseout', () => a.style.color = 'var(--fg2)');
    li.appendChild(a);
    ul.appendChild(li);
  });
  toc.appendChild(ul);
} else if (toc) {
  toc.innerHTML = '<p style="font-size:12px;color:var(--fg3);">—</p>';
}
</script>
